    {
      "id": 22,
      "title": "Cost per request",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oxide-prometheus"
      },
      "description": "CPU divided by throughput. Flat under rising load means linear scaling; a rise means something per-request is getting more expensive.",
      "gridPos": {
        "x": 16,
        "y": 31,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "oxide-prometheus"
          },
          "expr": "rate(process_cpu_seconds_total{service=\"showcase\"}[$__rate_interval]) / clamp_min(sum(rate(http_server_requests_seconds_count{service=\"showcase\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "CPU seconds per request",
          "refId": "A",
          "editorMode": "code",
          "range": true
