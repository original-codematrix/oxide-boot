      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oxide-prometheus"
      },
      "description": "Redis cache-aside on GET /api/notes/{id}. Entries expire after 30s, so a long run shows this sawtooth rather than climb to 1.",
