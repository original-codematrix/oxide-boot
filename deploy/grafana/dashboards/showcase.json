{
  "uid": "oxide-showcase",
  "title": "Oxide Boot \u2014 showcase under load",
  "description": "The showcase example (web + Mongo + Redis + Kafka) during a k6 run. Service metrics are scraped from /actuator/prometheus; the k6 row arrives via Prometheus remote write and is empty between runs. Queries use a 15s minimum step: the scrape interval is 2s, and rendering every raw point made the dashboard sluggish without showing anything more.",
  "tags": [
    "oxide-boot",
    "loadtest"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Service \u2014 the golden signals",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oxide-prometheus"
      },
      "description": "Requests per second per route, as counted by the service itself.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "oxide-prometheus"
          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{service=\"showcase\"}[$__rate_interval]))",
          "legendFormat": "{{uri}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "15s",
      "maxDataPoints": 500
    },
    {
      "id": 2,
      "title": "Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oxide-prometheus"
      },
      "description": "Server-side latency. Compare with the k6 row below: a gap between the two is queueing on the client or the network, not in the handler.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "oxide-prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"showcase\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "oxide-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"showcase\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "oxide-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"showcase\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "15s",
      "maxDataPoints": 500
    },
    {
      "id": 3,
      "title": "Error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oxide-prometheus"
      },
      "description": "clamp_min keeps the ratio defined when the numerator and denominator are both zero between scrapes. The 404s the load test issues on purpose show up in the 4xx line.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "oxide-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"showcase\", status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{service=\"showcase\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "oxide-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"showcase\", status=~\"4..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{service=\"showcase\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "4xx",
          "refId": "B",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "15s",
      "maxDataPoints": 500
    },
