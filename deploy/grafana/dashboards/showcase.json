        "x": 0,
        "y": 17,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "oxide-prometheus"
          },
          "expr": "sum(rate(showcase_cache_total{result=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(showcase_cache_total[$__rate_interval])), 1e-9)",
          "legendFormat": "hit ratio",
          "refId": "A",
          "editorMode": "code",
          "range": true
